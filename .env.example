# Klucz API do open-source LLM po API z dostawcą z UE.
# UWAGA: użyj OSOBNEGO klucza tylko na hackathon, z limitem wydatków.
# Po hackathonie klucz zrotuj / unieważnij. Nie commituj prawdziwego klucza
# do publicznego repo — do oceny dołącz plik .env z kluczem ewaluacyjnym.
LLM_API_KEY=
# LLM_API_BASE=https://api.mistral.ai/v1
# Model przypięty (Ministral 3 3B, 3,8B parametrów razem, Apache 2.0). NIE używać aliasów -latest.
# LLM_MODEL=ministral-3b-2512
