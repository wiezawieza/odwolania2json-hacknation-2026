# Klucz API do open-source LLM po API z dostawcą z UE (Mistral AI).
# Na VM ewaluacyjnej klucz trafia WYŁĄCZNIE do /opt/solution/.env na serwerze (patrz RUN.md),
# nigdy do repozytorium. Użyj OSOBNEGO klucza tylko na hackathon, z limitem wydatków;
# po hackathonie zrotuj go / unieważnij. Bez klucza aplikacja działa w trybie deterministycznym.
LLM_API_KEY=
# LLM_API_BASE=https://api.mistral.ai/v1
# Model przypięty (Ministral 3 3B, 3,8B parametrów razem, dense, Apache 2.0). NIE używać aliasów -latest.
# LLM_MODEL=ministral-3b-2512
